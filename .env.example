# ─── RELEYZ ENVIRONMENT VARIABLES ───────────────────────────
# Copy this file, rename it to .env.local for local development
# Add these same values in Vercel's Environment Variables settings

# Anthropic API Key (from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# API-Sports Key (from api-sports.io dashboard)
API_SPORTS_KEY=your-api-sports-key-here

# Stripe Keys (from dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key

# Your app's public URL (set this after deploying to Vercel)
NEXT_PUBLIC_APP_URL=https://releyz.vercel.app

# Set to "true" only during development to skip Stripe auth check
BYPASS_AUTH=false
